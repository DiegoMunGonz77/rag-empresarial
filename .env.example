# Copia este archivo a .env y completa los valores. Nunca subas .env a git.

# --- LLM ---
LLM_PROVIDER=gemini            # gemini | ollama | claude
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Opcionales
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- RAG ---
DATA_DIR=data
CHROMA_DIR=chroma_db
EMBEDDING_MODEL=intfloat/multilingual-e5-base
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
MIN_RELEVANCE=0.80
DEDUP_SIMILARITY=0.9
LLM_MAX_RETRIES=5
